# IMPORTANTE: Template de Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha seus valores reais
# NUNCA commitar o .env.local no Git!

# Sanity CMS
PUBLIC_SANITY_PROJECT_ID=sutrqo3v
PUBLIC_SANITY_DATASET=production
# SANITY_API_TOKEN nao e mais necessario: o site so le de um dataset publico.

# Deploy Hook da Vercel (crie em: Vercel → Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# Google Analytics 4 (opcional - o default ja esta no codigo)
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Site
PUBLIC_SITE_URL=https://dinn.ai
