---
import '@/styles/global.css';
import Header from '@/components/Header';
import Footer from '@/components/Footer';
import { HTML_LANG, OG_LOCALE, type Lang } from '@/i18n/routes';

interface Props {
	title?: string;
	description?: string;
	/** Caminho ou URL da imagem de compartilhamento (1200x630). */
	image?: string;
	/** og:type — 'article' nas páginas de post. */
	type?: 'website' | 'article';
	/** Bloqueia indexação (formulários, páginas internas). */
	noindex?: boolean;
	/** Structured data extra, anexado ao schema de Organization. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Idioma desta página. O site é PT por padrão; /en e /es declaram o seu. */
	lang?: Lang;
	/**
	 * Versões da mesma página em outros idiomas (inclua a própria página).
	 * Viram <link rel="alternate" hreflang>, que o seletor de idioma também lê
	 * para levar o leitor à versão equivalente.
	 */
	alternates?: { lang: Lang; href: string }[];
	/**
	 * Quando true, a página acompanha o idioma escolhido no seletor: abre a
	 * versão do idioma do leitor (se existir) e, ao trocar, navega para ela.
	 */
	langRoute?: boolean;
	/** Para onde ir ao trocar de idioma quando não há versão equivalente. */
	langFallbacks?: Partial<Record<Lang, string>>;
}

const {
	title = "Dinn | Inteligência comercial para o canal farmacêutico",
	description = "IA para o mercado farma: a Dinn organiza sinais de disponibilidade, giro e preço do canal, mostra origem, data e limites e ajuda o time a decidir onde agir.",
	image = '/og-image.png',
	type = 'website',
	noindex = false,
	jsonLd,
	lang = 'pt',
	alternates = [],
	langRoute = false,
	langFallbacks = {},
} = Astro.props;

// Descrições vindas do Sanity trazem quebras de linha e tamanho livre; sem
// normalizar, elas entram cruas no atributo e passam do corte do Google (~160).
function normalizeDescription(text: string): string {
	const clean = text.replace(/\s+/g, ' ').trim();
	if (clean.length <= 160) return clean;
	return `${clean.slice(0, 157).replace(/[\s,;:.-]+$/, '')}…`;
}

const metaDescription = normalizeDescription(description);

// URL canônica sempre com barra final, para bater com o formato de diretório
// que o Astro gera e com as URLs do sitemap. Divergir aqui faria a mesma página
// ser indexada em duas variantes.
const site = Astro.site ?? new URL('https://dinn.ai');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;

// hreflang: cada versão aponta para todas as outras (e para si mesma); o
// x-default é o português, idioma padrão do site.
const hreflangLinks = alternates.map((alt) => ({
	hreflang: HTML_LANG[alt.lang],
	href: new URL(alt.href, site).href,
}));
const defaultAlternate = alternates.find((alt) => alt.lang === 'pt');

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Dinn",
	"description": "Inteligência comercial para o canal farmacêutico: transforma sinais de disponibilidade, giro e preço em ação comercial, com origem, data e limites explícitos",
	"url": site.href,
	"logo": new URL('/logo.png', site).href,
	"foundingDate": "2023",
	"founders": [{
		"@type": "Organization",
		"name": "DiWE Ventures Studio"
	}]
};

const schemas = [organizationSchema, ...(jsonLd ? [jsonLd].flat() : [])];

// GA4. O measurement ID é público (aparece no HTML), então o default fica no
// código; PUBLIC_GA_ID permite apontar para outra propriedade sem alterar fonte.
// Só carrega em build de produção — senão navegação local suja os relatórios.
const GA_ID = import.meta.env.PUBLIC_GA_ID ?? 'G-4JX0VZ49DD';
const enableAnalytics = import.meta.env.PROD && Boolean(GA_ID);

// Apollo Website Visitors: identifica empresas que visitam o site pro
// comercial (conta de intent data). Mesmo racional do GA — só produção.
// Tracker da conta Apollo paga, onde a Dinn executa a prospecção desde
// 27/09/2026 (isolada por prefixo DINN- e dono; regras em dinn-os,
// integrations/apollo-hubspot-prospecting.md). O snippet do Apollo é instância
// única por página, então só um tracker roda: o da conta que executa.
const APOLLO_TRACKER_ID = '663123272a6e2c030219f444';
const enableApolloTracking = import.meta.env.PROD;
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-page-lang={lang} data-lang-route={langRoute ? 'auto' : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonical} />
		{hreflangLinks.map((link) => (
			<link rel="alternate" hreflang={link.hreflang} href={link.href} />
		))}
		{defaultAlternate && (
			<link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.href, site).href} />
		)}
		{Object.entries(langFallbacks).map(([code, href]) => (
			<meta name={`dinn:lang-fallback:${code}`} content={href} />
		))}
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" type="image/png" href="/favicon.png" />

		{/* Pesos usados pelo H1 do hero (LCP). Sem o preload eles só seriam
		    descobertos depois que o CSS baixasse e casasse as regras. */}
		<link rel="preload" href="/fonts/BrittiSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/BrittiSans-LightItalic.woff2" as="font" type="font/woff2" crossorigin />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:locale" content={OG_LOCALE[lang]} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Dinn" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter/X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={imageUrl} />

		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}

		{enableAnalytics && (
			<>
				<link rel="preconnect" href="https://www.googletagmanager.com" />
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				{/* set:html em vez de define:vars: o define:vars envolve o script num
				    IIFE, o que deixaria gtag fora do escopo global e faria qualquer
				    gtag('event', ...) posterior estourar ReferenceError. */}
				<script is:inline set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag('js', new Date());
gtag('config', '${GA_ID}');
`}></script>
			</>
		)}

		{enableApolloTracking && (
			<script is:inline set:html={`
function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,o.onload=function(){window.trackingFunctions.onLoad({appId:"${APOLLO_TRACKER_ID}"})},document.head.appendChild(o)}initApollo();
`}></script>
		)}
	</head>
	<body style="background-color: #1F2328; color: #1F2328; margin: 0; padding: 0; overflow-x: clip;">
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
		<Header client:load />
		<main id="conteudo" tabindex="-1">
			<slot />
		</main>
		<Footer client:load />
	</body>
</html>
