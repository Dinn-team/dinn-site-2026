---
// Página de um estudo, compartilhada pelas três rotas de idioma.
// Palco escuro (mesmo das apresentações) com título, botão de download e a amostra:
// até 5 páginas do PDF lado a lado, e no fim um cartão que leva ao estudo completo.
// Abaixo: resumo em texto (para leitura e busca), fechamento e outros estudos.
// O download do PDF completo passa pelo modal de 4 campos (StudyDownload).
import Layout from '@/layouts/Layout.astro';
import StudyCard from '@/components/studies/StudyCard.astro';
import StudyDownload from '@/components/studies/StudyDownload';
import { HTML_LANG, studiesPath, studyPath, type Lang } from '@/i18n/routes';
import { cardVariant } from '@/lib/presentations';
import {
  fill,
  formatStudyDate,
  studyAlternates,
  studyErrors,
  studyGradient,
  studyLabels,
  studyRoles,
  type Study,
} from '@/lib/studies';

interface Props {
  study: Study;
  lang: Lang;
  others: Study[];
}

const { study, lang, others } = Astro.props;
const labels = studyLabels(lang);
const text = study.langs[lang];
const date = formatStudyDate(lang, study.publishedAt);
const gradient = studyGradient(study);
const remaining = Math.max(text.pages - text.sample.length, 0);

const site = Astro.site ?? new URL('https://www.dinn.ai');
const pageUrl = new URL(studyPath(lang, study.slug), site).href;
const listUrl = new URL(studiesPath(lang), site).href;
const description = text.subtitle || text.abstract[0]?.slice(0, 200) || text.title;
const shareImage = text.sample[0]?.src ?? '/og-image.png';

const reportSchema = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: text.title,
  headline: text.title,
  alternativeHeadline: text.subtitle,
  abstract: text.abstract.join(' '),
  description,
  inLanguage: HTML_LANG[lang],
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: study.publishedAt,
  keywords: text.keywords.join(', '),
  image: new URL(shareImage, site).href,
  author: { '@type': 'Organization', name: 'Dinn' },
  publisher: {
    '@type': 'Organization',
    name: 'Dinn',
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', site).href },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: labels.breadcrumbHome, item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: labels.name, item: listUrl },
    { '@type': 'ListItem', position: 3, name: text.title, item: pageUrl },
  ],
};

const files = {
  pt: { file: study.langs.pt.file, title: study.langs.pt.title },
  en: { file: study.langs.en.file, title: study.langs.en.title },
  es: { file: study.langs.es.file, title: study.langs.es.title },
};

const downloadLabels = { ...labels.form, close: labels.close, errors: studyErrors(lang) };
const pageLabel = (n: number) => fill(labels.pageOf, { n, total: text.pages });
---

<Layout
  title={`${text.title} | ${labels.titleSuffix}`}
  description={description}
  image={shareImage}
  type="article"
  jsonLd={[reportSchema, breadcrumbSchema]}
  lang={lang}
  alternates={studyAlternates(study.slug)}
  langRoute
>
  <div class="h2 pr sm">
    <section class="pr-band sm-band" style={`--pr-g: url(${gradient})`} aria-labelledby="sm-title">
      <div class="h2-wrap">
        <div class="pr-bar">
          <a href={studiesPath(lang)} class="pr-back">← {labels.backToList}</a>
        </div>

        <div class="sm-head">
          <div class="sm-head-text">
            <p class="sm-meta">
              <span>{labels.kind}</span>
              <time datetime={study.publishedAt}>{date}</time>
              <span>{text.pages} {labels.pages}</span>
              <span>{labels.languages}</span>
            </p>
            <h1 id="sm-title" class="sm-title">{text.title}</h1>
            {text.subtitle && <p class="sm-sub">{text.subtitle}</p>}
          </div>
          <button type="button" class="btn btn-primary btn-lg sm-cta" data-study-download>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3" /><path d="m7 10 5 5 5-5" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /></svg>
            {labels.download}
          </button>
        </div>
      </div>

      <div class="sm-reader" data-sm-reader>
        <div class="h2-wrap sm-reader-head">
          <div>
            <h2 class="sm-reader-title">{labels.sampleTitle}</h2>
            <p class="sm-reader-lead">{fill(labels.sampleLead, { n: text.sample.length, total: text.pages })}</p>
          </div>
          <div class="sm-arrows">
            <button type="button" data-sm-prev aria-label={labels.prev} aria-disabled="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button type="button" data-sm-next aria-label={labels.next}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        </div>

        <ol class="sm-track" data-sm-track aria-label={labels.sampleLabel} tabindex="0">
          {text.sample.map((page, i) => (
            <li class="sm-page">
              <button type="button" class="sm-page-btn" data-sm-open={page.src} data-sm-alt={pageLabel(page.page)} aria-label={fill(labels.openPage, { n: page.page })}>
                <img
                  src={page.src}
                  alt={pageLabel(page.page)}
                  width="1100"
                  height="1556"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </button>
              <span class="sm-page-num" aria-hidden="true">{page.page}</span>
            </li>
          ))}
          {remaining > 0 && (
            <li class="sm-page sm-more">
              <div class="sm-more-in">
                <p class="sm-more-title">{labels.moreTitle}</p>
                <p class="sm-more-text">{fill(labels.moreText, { n: remaining })}</p>
                <button type="button" class="btn btn-primary" data-study-download>{labels.download}</button>
              </div>
            </li>
          )}
        </ol>
      </div>
    </section>

    <div class="h2-wrap">
      <section class="sm-abstract" aria-labelledby="sm-abstract-title">
        <div class="sm-abstract-side">
          <h2 id="sm-abstract-title" class="h2-title">{labels.abstractTitle}</h2>
          {text.keywords.length > 0 && (
            <div class="sm-keywords">
              <p class="sm-label">{labels.keywords}</p>
              <ul class="pr-chips">
                {text.keywords.map((keyword) => <li>{keyword}</li>)}
              </ul>
            </div>
          )}
        </div>
        <div class="sm-abstract-body">
          {text.abstract.map((paragraph) => <p>{paragraph}</p>)}
          <p class="sm-scope">
            {labels.scopeNote} {fill(labels.reviewedBy, { name: study.reviewer })}.
          </p>
          <div class="h2-actions">
            <button type="button" class="btn btn-primary" data-study-download>{labels.download}</button>
          </div>
        </div>
      </section>

      {/* Sem a classe `cc`: o banner de cookies usa o mesmo nome e esconde o cartão. */}
      <section class="ap-cta" aria-labelledby="sm-order-title">
        <div class="cc-card" style="--cc-g: url(/gradients/g03.avif)">
          <h2 id="sm-order-title">{labels.order.title}</h2>
          <p>{labels.order.text}</p>
          <div class="h2-actions">
            <a href="/pesquisas" class="btn btn-primary">{labels.order.cta}</a>
          </div>
        </div>
      </section>

      {others.length > 0 && (
        <section class="ap-rec" aria-labelledby="sm-others-title">
          <h2 id="sm-others-title" class="h2-title">{labels.others}</h2>
          <ul class="pr-grid">
            {others.map((other, i) => (
              <li>
                <StudyCard study={other} lang={lang} variant={cardVariant(i)} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {/* Leitor ampliado: as páginas da amostra uma embaixo da outra, como um PDF. */}
    <dialog class="sm-zoom" data-sm-zoom aria-label={labels.sampleLabel} data-page-of={labels.pageOf} data-total={text.pages}>
      <div class="sm-zoom-bar">
        <p class="sm-zoom-count" data-sm-zoom-count aria-live="polite">{pageLabel(text.sample[0]?.page ?? 1)}</p>
        <div class="sm-zoom-tools">
          <button type="button" data-sm-zoom-prev aria-label={labels.prev}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
          </button>
          <button type="button" data-sm-zoom-next aria-label={labels.next}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <button type="button" class="btn btn-primary sm-zoom-dl" data-study-download>{labels.form.submit}</button>
          <button type="button" class="sm-zoom-close" data-sm-zoom-close aria-label={labels.close}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
          </button>
        </div>
      </div>
      <div class="sm-zoom-pages" data-sm-zoom-scroll tabindex="0">
        {text.sample.map((page) => (
          <img data-sm-zoom-page data-page={page.page} src={page.src} alt={pageLabel(page.page)} width="1100" height="1556" loading="lazy" decoding="async" />
        ))}
        {remaining > 0 && (
          <div class="sm-zoom-more" data-sm-zoom-page data-page={text.sample[text.sample.length - 1].page + 1}>
            <p class="sm-more-title">{labels.moreTitle}</p>
            <p class="sm-more-text">{fill(labels.moreText, { n: remaining })}</p>
            <button type="button" class="btn btn-primary" data-study-download>{labels.download}</button>
          </div>
        )}
      </div>
    </dialog>

    <StudyDownload client:load lang={lang} slug={study.slug} files={files} roles={studyRoles(lang)} labels={downloadLabels} />
  </div>
</Layout>

<script>
  // Amostra: setas que andam uma página por vez e página ampliada ao clicar.
  // Sem JavaScript, a faixa ainda rola com o dedo, o mouse ou o teclado.
  function setupReader(reader: HTMLElement) {
    const track = reader.querySelector<HTMLElement>('[data-sm-track]');
    const prev = reader.querySelector<HTMLButtonElement>('[data-sm-prev]');
    const next = reader.querySelector<HTMLButtonElement>('[data-sm-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const first = track.querySelector<HTMLElement>('.sm-page');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first ? first.offsetWidth + gap : track.clientWidth;
    };
    const max = () => track.scrollWidth - track.clientWidth;
    const update = () => {
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 2));
      next.setAttribute('aria-disabled', String(track.scrollLeft >= max() - 2));
    };
    // Alvo da rolagem guardado à parte: cliques seguidos somam páginas, mesmo
    // antes de a rolagem suave terminar.
    let target = 0;
    let settle = 0;
    const go = (dir: number) => {
      target = Math.min(Math.max(Math.round(target / step()) * step() + dir * step(), 0), max());
      track.scrollTo({ left: target, behavior: 'smooth' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener(
      'scroll',
      () => {
        update();
        window.clearTimeout(settle);
        settle = window.setTimeout(() => (target = track.scrollLeft), 160);
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }

  // Leitor ampliado: abre na página clicada e rola na vertical, como um PDF.
  // Setas da barra e do teclado (↑ ↓ ← → PageUp PageDown) andam uma página.
  function setupZoom() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-sm-zoom]');
    const scroller = dialog?.querySelector<HTMLElement>('[data-sm-zoom-scroll]');
    const count = dialog?.querySelector<HTMLElement>('[data-sm-zoom-count]');
    const prev = dialog?.querySelector<HTMLButtonElement>('[data-sm-zoom-prev]');
    const next = dialog?.querySelector<HTMLButtonElement>('[data-sm-zoom-next]');
    if (!dialog || !scroller || !count || !prev || !next) return;
    const pages = [...scroller.querySelectorAll<HTMLElement>('[data-sm-zoom-page]')];
    const template = dialog.dataset.pageOf ?? '{n} / {total}';
    const total = dialog.dataset.total ?? '';
    const sampleCount = scroller.querySelectorAll('img[data-sm-zoom-page]').length;
    let current = 0;

    // A área de leitura tem `position: relative`: offsetTop já é medido a partir dela.
    const top = (i: number) => Math.max(pages[i].offsetTop - 16, 0);
    const render = () => {
      // No cartão final, o contador continua na última página da amostra.
      const page = pages[Math.min(current, sampleCount - 1)]?.dataset.page ?? '1';
      count.textContent = template.replace('{n}', page).replace('{total}', total);
      prev.disabled = current <= 0;
      next.disabled = current >= pages.length - 1;
    };
    const goTo = (i: number, smooth = true) => {
      current = Math.min(Math.max(i, 0), pages.length - 1);
      scroller.scrollTo({ top: top(current), behavior: smooth ? 'smooth' : 'auto' });
      render();
    };

    // A página atual é a que ocupa o meio da área de leitura.
    let ticking = false;
    scroller.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const middle = scroller.scrollTop + scroller.clientHeight / 2;
          let found = 0;
          pages.forEach((p, i) => {
            if (top(i) <= middle) found = i;
          });
          // No fim da rolagem, a última posição é a atual (o cartão final é baixo).
          if (scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 4) found = pages.length - 1;
          if (found !== current) {
            current = found;
            render();
          }
        });
      },
      { passive: true },
    );

    document.querySelectorAll<HTMLButtonElement>('[data-sm-open]').forEach((button, i) => {
      button.addEventListener('click', () => {
        dialog.showModal();
        scroller.focus({ preventScroll: true });
        goTo(i, false);
      });
    });
    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    dialog.addEventListener('keydown', (event) => {
      if ((event.target as HTMLElement).closest('button')) return;
      if (['ArrowDown', 'ArrowRight', 'PageDown'].includes(event.key)) {
        event.preventDefault();
        goTo(current + 1);
      } else if (['ArrowUp', 'ArrowLeft', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        goTo(current - 1);
      }
    });
    dialog.querySelector('[data-sm-zoom-close]')?.addEventListener('click', () => dialog.close());
    // O modal de download abre por cima: o leitor fecha antes.
    dialog.querySelectorAll('[data-study-download]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-sm-reader]').forEach(setupReader);
  setupZoom();
</script>
