---
// Página de artigo do blog, compartilhada pelas três rotas de idioma:
//   /articles/<slug>   /en/articles/<slug>   /es/articles/<slug>
// Os textos de interface são resolvidos aqui, no build, no idioma do artigo —
// o HTML já sai no idioma certo para o leitor e para os buscadores.
import Layout from '@/layouts/Layout.astro';
import { urlFor } from '@/sanity/lib/client';
import ArticleBody from '@/components/blog/ArticleBody';
import { DynamicIslandTOC } from '@/components/ui/dynamic-island-toc';
import { articlePath, blogPath, HTML_LANG, type Lang } from '@/i18n/routes';
import { contactUrl } from '@/lib/links';
import {
  articleAlternates,
  blogFallbacks,
  blogLabels,
  calcReadTime,
  categoryLabel,
  formatPostDate,
  type BlogPostData,
} from '@/lib/blog';

interface Props {
  post: BlogPostData;
  lang: Lang;
  recommended: BlogPostData[];
}

const { post, lang, recommended } = Astro.props;
const labels = blogLabels(lang);

const TITLE_SUFFIX: Record<Lang, string> = { pt: 'Blog Dinn', en: 'Dinn Blog', es: 'Blog de Dinn' };

const readTime = calcReadTime(post.body);
const coverUrl = post.coverImage ? urlFor(post.coverImage).width(1400).height(700).fit('crop').url() : null;

// Imagem de compartilhamento no formato que as redes esperam (1200x630).
const shareImage = post.coverImage
  ? urlFor(post.coverImage).width(1200).height(630).fit('crop').url()
  : '/og-image.png';

const description = post.excerpt || post.title;

// Autor(a): o cadastro (authorRef) tem prioridade; o texto antigo serve de reserva.
const profile = post.authorProfile;
const authorName = profile?.name || post.author || '';
const authorRole = profile?.role || '';
const authorImage = profile?.image
  ? urlFor(profile.image).width(256).height(256).fit('crop').url()
  : '';
const authorAvatar = profile?.image
  ? urlFor(profile.image).width(96).height(96).fit('crop').url()
  : '';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": description,
  "inLanguage": HTML_LANG[lang],
  "datePublished": post.publishedAt,
  "dateModified": post._updatedAt || post.publishedAt,
  "author": {
    "@type": "Person",
    "name": authorName || "Dinn",
    ...(authorRole ? { jobTitle: authorRole } : {}),
    ...(authorImage ? { image: authorImage } : {}),
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dinn",
    "logo": { "@type": "ImageObject", "url": new URL('/logo.png', Astro.site).href }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href },
  ...(post.coverImage ? { image: shareImage } : {}),
};
---

<Layout
  title={`${post.title} | ${TITLE_SUFFIX[lang]}`}
  description={description}
  image={shareImage}
  type="article"
  jsonLd={articleSchema}
  lang={lang}
  alternates={articleAlternates(post, lang)}
  langRoute
  langFallbacks={blogFallbacks()}
>
  <DynamicIslandTOC client:load selector=".bp-body h2, .bp-body h3, .bp-body h4" />

  <div class="h2 ap">
    <header class="h2-hero ap-hero">
      <div class="h2-wrap">
        <a href={blogPath(lang)} class="h2-link ap-back">← {labels.backToBlog}</a>
        <div class="h2-hero-grid">
          <div>
            <p class="ap-meta">
              {post.categories && post.categories.length > 0 && <span class="ap-cat">{categoryLabel(lang, post.categories[0])}</span>}
              <span>{readTime} {labels.minRead}</span>
            </p>
            <h1 class="ap-title">{post.title}</h1>
          </div>
          <div class="h2-hero-side">
            {post.excerpt && <p class="h2-hero-sub">{post.excerpt}</p>}
          </div>
        </div>

        <div class="ap-byline">
          {authorName && (
            <span class="ap-author">
              {authorAvatar && <img src={authorAvatar} alt={authorName} class="ap-avatar" width="40" height="40" />}
              <span>
                <span class="ap-author-name">{labels.writtenBy} {authorName}</span>
                {authorRole && <span class="ap-author-role">{authorRole}</span>}
              </span>
            </span>
          )}
          {post.publishedAt && (
            <time class="ap-date" datetime={post.publishedAt}>{formatPostDate(lang, post.publishedAt)}</time>
          )}
        </div>

        {coverUrl && (
          <div class="ap-cover bg-img">
            <img src={coverUrl} alt={post.title} />
          </div>
        )}
      </div>
    </header>

    <div class="h2-wrap ap-main">
      <div class="bp-body ap-body">
        {post.body && <ArticleBody value={post.body} />}
      </div>

      <section class="cc ap-cta" aria-labelledby="ap-cta-title">
        <div class="cc-card" style="--cc-g: url(/gradients/g03.avif)">
          <h2 id="ap-cta-title">{labels.ctaTitle}</h2>
          <p>{labels.ctaText}</p>
          <div class="h2-actions">
            <a href={contactUrl(`artigo-${post.slug.current}`)} class="btn btn-primary">{labels.ctaBtn}</a>
          </div>
        </div>
      </section>

      {recommended.length > 0 && (
        <section class="ap-rec" aria-labelledby="ap-rec-title">
          <h2 id="ap-rec-title" class="h2-title">{labels.recommended}</h2>
          <ul class="bg-grid">
            {recommended.map((rec) => (
              <li>
                <a href={articlePath(lang, rec.slug.current)} class="bg-card">
                  {rec.coverImage && (
                    <span class="bg-img">
                      <img src={urlFor(rec.coverImage).width(600).height(375).url()} alt={rec.title} loading="lazy" />
                    </span>
                  )}
                  <h3>{rec.title}</h3>
                  <span class="h2-link">{labels.readArticle} →</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
