---
// Página de uma apresentação, compartilhada pelas três rotas de idioma:
//   /apresentacoes/<slug>   /en/presentations/<slug>   /es/presentaciones/<slug>
// O texto de todos os slides sai no HTML do build. A ilha React só cuida da
// navegação (setas, teclado, deslizar, #slide-N).
import Layout from '@/layouts/Layout.astro';
import PresentationDeck from '@/components/blog/PresentationDeck';
import PresentationCard from '@/components/blog/PresentationCard.astro';
import { urlFor } from '@/sanity/lib/client';
import { articlePath, HTML_LANG, presentationPath, presentationsPath, type Lang } from '@/i18n/routes';
import { contactUrl } from '@/lib/links';
import { blogLabels, categoryLabel, formatPostDate } from '@/lib/blog';
import {
  presentationAlternates,
  presentationFallbacks,
  presentationLabels,
  slidePlainText,
  type PresentationPost,
} from '@/lib/presentations';

interface Props {
  post: PresentationPost;
  lang: Lang;
  others: PresentationPost[];
}

const { post, lang, others } = Astro.props;
const labels = presentationLabels(lang);
const blog = blogLabels(lang);
const slug = post.slug.current;

const site = Astro.site ?? new URL('https://dinn.ai');
const pageUrl = new URL(presentationPath(lang, slug), site).href;
const articleUrl = new URL(articlePath(lang, slug), site).href;
const listUrl = new URL(presentationsPath(lang), site).href;
const listName = labels.name;

// Resumo do artigo; sem ele, o texto do primeiro slide que tiver texto.
const description =
  post.excerpt || post.slides.map(slidePlainText).find((text) => text.length > 0) || post.title;

const shareImage = post.coverImage
  ? urlFor(post.coverImage).width(1200).height(630).fit('crop').url()
  : '/og-image.png';

const profile = post.authorProfile;
const authorName = profile?.name || post.author || '';

const generatedAt = post.presentation?.generatedAt;

const presentationSchema = {
  '@context': 'https://schema.org',
  '@type': 'PresentationDigitalDocument',
  name: post.title,
  headline: post.title,
  description,
  inLanguage: HTML_LANG[lang],
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  datePublished: generatedAt || post.publishedAt,
  dateModified: post._updatedAt || generatedAt || post.publishedAt,
  isBasedOn: {
    '@type': 'Article',
    '@id': articleUrl,
    url: articleUrl,
    headline: post.title,
    datePublished: post.publishedAt,
  },
  author: { '@type': 'Person', name: authorName || 'Dinn' },
  publisher: {
    '@type': 'Organization',
    name: 'Dinn',
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', site).href },
  },
  hasPart: post.slides.map((slide, i) => ({ '@type': 'CreativeWork', position: i + 1, name: slide.title })),
  ...(post.coverImage ? { image: shareImage } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: labels.breadcrumbHome, item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: listName, item: listUrl },
    { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
  ],
};

const deckLabels = {
  deck: labels.deckLabel,
  slideOf: labels.slideOf,
  prev: labels.prev,
  next: labels.next,
  goTo: labels.goTo,
};
---

<Layout
  title={`${post.title} | ${labels.titleSuffix}`}
  description={description}
  image={shareImage}
  type="article"
  jsonLd={[presentationSchema, breadcrumbSchema]}
  lang={lang}
  alternates={presentationAlternates(post, lang)}
  langRoute
  langFallbacks={presentationFallbacks()}
>
  <div class="h2 pr">
    <header class="h2-hero ap-hero">
      <div class="h2-wrap">
        <a href={presentationsPath(lang)} class="h2-link ap-back">← {labels.backToList}</a>
        <div class="h2-hero-grid">
          <div>
            <p class="pr-meta">
              {post.categories && post.categories.length > 0 && <span>{categoryLabel(lang, post.categories[0])}</span>}
              <span>{post.slides.length} {labels.slides}</span>
              <time datetime={post.publishedAt}>{formatPostDate(lang, post.publishedAt)}</time>
            </p>
            <h1 class="ap-title">{post.title}</h1>
          </div>
          <div class="h2-hero-side">
            {post.excerpt && <p class="h2-hero-sub">{post.excerpt}</p>}
            <div class="h2-actions">
              <a href={articlePath(lang, slug)} class="btn btn-primary">{labels.fullArticle}</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="h2-wrap pr-stage">
      <PresentationDeck client:load slides={post.slides} labels={deckLabels} />
      <p class="pr-after">
        <a href={articlePath(lang, slug)} class="h2-link">{labels.fullArticle} →</a>
      </p>
    </div>

    <div class="h2-wrap">
      {/* Sem a classe `cc`: o banner de cookies usa o mesmo nome e esconde o cartão. */}
      <section class="ap-cta" aria-labelledby="pr-cta-title">
        <div class="cc-card" style="--cc-g: url(/gradients/g03.avif)">
          <h2 id="pr-cta-title">{blog.ctaTitle}</h2>
          <p>{blog.ctaText}</p>
          <div class="h2-actions">
            <a href={contactUrl(`apresentacao-${slug}`)} class="btn btn-primary">{blog.ctaBtn}</a>
          </div>
        </div>
      </section>

      {others.length > 0 && (
        <section class="ap-rec" aria-labelledby="pr-others-title">
          <h2 id="pr-others-title" class="h2-title">{labels.others}</h2>
          <ul class="bg-grid pr-grid">
            {others.map((other) => (
              <li>
                <PresentationCard post={other} lang={lang} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
