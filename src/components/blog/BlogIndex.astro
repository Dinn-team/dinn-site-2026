---
// Lista do blog, compartilhada pelas três rotas de idioma:
//   /blog   /en/blog   /es/blog
import Layout from '@/layouts/Layout.astro';
import BlogInteractive from '@/components/ui/BlogInteractive';
import { urlFor } from '@/sanity/lib/client';
import { blogLabels, getPosts } from '@/lib/blog';
import { blogPath, LANGS, type Lang } from '@/i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const META: Record<Lang, { title: string; description: string }> = {
  pt: {
    title: 'Blog | Dinn',
    description: 'Insights, tendências e novidades sobre o mercado farmacêutico e gestão de farmácias.',
  },
  en: {
    title: 'Blog | Dinn',
    description: 'Insights, trends and news on the pharmaceutical market and pharmacy management.',
  },
  es: {
    title: 'Blog | Dinn',
    description: 'Perspectivas, tendencias y novedades sobre el mercado farmacéutico y la gestión de farmacias.',
  },
};

const posts = await getPosts(lang);
const mappedPosts = posts.map((post) => ({
  _id: post._id,
  title: post.title,
  slug: post.slug,
  excerpt: post.excerpt ?? '',
  author: post.author ?? '',
  publishedAt: post.publishedAt,
  imageUrl: post.coverImage ? urlFor(post.coverImage).width(600).height(400).url() : undefined,
  categories: post.categories || [],
}));

const blog = blogLabels(lang);
const labels = {
  heroTitle: blog.heroTitle,
  searchPlaceholder: blog.searchPlaceholder,
  noResultsTitle: blog.noResultsTitle,
  noResultsDesc: blog.noResultsDesc,
  readArticle: blog.readArticle,
  defaultCategory: blog.defaultCategory,
  allCategories: blog.allCategories,
  categories: blog.categories as Record<string, string>,
};
---

<Layout
  title={META[lang].title}
  description={META[lang].description}
  lang={lang}
  alternates={LANGS.map((code) => ({ lang: code, href: blogPath(code) }))}
  langRoute
>
    <BlogInteractive client:load posts={mappedPosts} lang={lang} labels={labels} />
</Layout>
