---
import Layout from '@/layouts/Layout.astro';
import BlogInteractive from '@/components/ui/BlogInteractive';
import { client, urlFor } from '@/sanity/lib/client';
import { postsQuery } from '@/sanity/lib/queries';

let posts = [];
let mappedPosts = [];
try {
    posts = await client.fetch(postsQuery);
    mappedPosts = posts.map((post: any) => ({
      _id: post._id,
      title: post.title,
      slug: post.slug,
      excerpt: post.excerpt,
      author: post.author,
      publishedAt: post.publishedAt,
      imageUrl: post.coverImage ? urlFor(post.coverImage).width(600).height(400).url() : undefined,
      categories: post.categories || []
    }));
} catch (error) {
    console.error('Error fetching posts:', error);
}
---

<Layout title="Blog | Dinn" description="Insights, tendências e novidades sobre o mercado farmacêutico e gestão de farmácias.">
    <BlogInteractive client:load posts={mappedPosts} />
</Layout>

<style is:global>
/* ── Página geral ── */
.blog-page {
  background-color: #ffffff;
  color: #1a1a1a;
  min-height: 100vh;
}

/* ── Hero mínimo ── */
.blog-hero {
  background-color: #0f172a; /* mantém identidade do DINN */
  padding: 64px 24px 56px;
  text-align: center;
}

.blog-hero h1 {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
  letter-spacing: -0.02em;
}

.blog-hero p {
  font-size: 16px;
  color: #94a3b8;
  margin-bottom: 32px;
}

.blog-search {
  max-width: 480px;
  margin: 0 auto;
  position: relative;
}

.blog-search input {
  width: 100%;
  padding: 14px 48px 14px 24px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.08);
  color: #fff;
  font-size: 15px;
  outline: none;
  transition: border-color 0.2s;
}

.blog-search input::placeholder { color: #64748b; }
.blog-search input:focus { border-color: rgba(255,255,255,0.3); }

.blog-search-icon {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  color: #64748b;
}

/* ── Filtros de categoria ── */
.blog-filters {
  max-width: 1120px;
  margin: 0 auto;
  padding: 32px 24px 0;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.blog-filter-btn {
  padding: 8px 18px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  background: transparent;
  font-size: 14px;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s;
  font-weight: 500;
}

.blog-filter-btn:hover {
  border-color: #94a3b8;
  color: #1e293b;
}

.blog-filter-btn.active {
  background: #0f172a;
  border-color: #0f172a;
  color: #ffffff;
}

/* ── Container principal ── */
.blog-container {
  max-width: 1120px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ── Card featured (artigo mais recente) ── */
.blog-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 64px;
  padding-bottom: 64px;
  border-bottom: 1px solid #e2e8f0;
}

.blog-featured-image {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 12px;
}

.blog-featured-tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #5625F2; /* Dinn Accent */
  margin-bottom: 12px;
}

.blog-featured-title {
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  margin-bottom: 16px;
  letter-spacing: -0.01em;
}

.blog-featured-excerpt {
  font-size: 16px;
  color: #475569;
  line-height: 1.7;
  margin-bottom: 24px;
}

.blog-featured-meta {
  font-size: 13px;
  color: #94a3b8;
  margin-bottom: 24px;
}

.blog-featured-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  text-decoration: none;
  border-bottom: 2px solid #0f172a;
  padding-bottom: 2px;
  transition: opacity 0.15s;
}

.blog-featured-link:hover { opacity: 0.6; }

/* ── Grid de artigos ── */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

/* ── Card individual ── */
.blog-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s;
}

.blog-card:hover { transform: translateY(-4px); }
.blog-card:hover .blog-card-title { color: #5625F2; /* Dinn Accent */ }

.blog-card-meta {
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.blog-card-category {
  color: #5625F2; /* Dinn Accent */
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.blog-card-title {
  font-size: 17px;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  margin-bottom: 10px;
  transition: color 0.15s;
  /* 3 linhas máximo */
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blog-card-excerpt {
  font-size: 14px;
  color: #64748b;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Paginação ── */
.blog-pagination {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 56px;
}

.blog-pagination button {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
  background: transparent;
  font-size: 14px;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s;
}

.blog-pagination button.active {
  background: #0f172a;
  border-color: #0f172a;
  color: #fff;
}

.blog-pagination button:hover:not(.active) {
  border-color: #94a3b8;
}

/* ── Responsivo ── */
@media (max-width: 900px) {
  .blog-featured { grid-template-columns: 1fr; gap: 24px; }
  .blog-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
}

@media (max-width: 560px) {
  .blog-grid { grid-template-columns: 1fr; }
  .blog-hero { padding: 48px 20px 40px; }
}
</style>
