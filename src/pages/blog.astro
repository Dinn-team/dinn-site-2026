---
import Layout from '@/layouts/Layout.astro';
import BlogInteractive from '@/components/ui/BlogInteractive';
import { client, urlFor } from '@/sanity/lib/client';
import { postsQuery } from '@/sanity/lib/queries';

let posts = [];
let mappedPosts = [];
try {
    posts = await client.fetch(postsQuery);
    mappedPosts = posts.map((post: any) => ({
      _id: post._id,
      title: post.title,
      slug: post.slug,
      excerpt: post.excerpt,
      author: post.author,
      publishedAt: post.publishedAt,
      imageUrl: post.coverImage ? urlFor(post.coverImage).width(600).height(400).url() : undefined,
      categories: post.categories || []
    }));
} catch (error) {
    console.error('Error fetching posts:', error);
}
---

<Layout title="Blog | Dinn" description="Insights, tendências e novidades sobre o mercado farmacêutico e gestão de farmácias.">
    <BlogInteractive client:load posts={mappedPosts} />
</Layout>
