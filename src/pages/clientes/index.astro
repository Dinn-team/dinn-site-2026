---
import Layout from '@/layouts/Layout.astro';
import { CustomersIndex } from '@/components/site/CustomersPages';
import { pagesPt } from '@/i18n/locales/pt.pages';
import { getLabs, getLogoCredits } from '@/lib/labs';

const { title, description } = pagesPt.clients.meta;
// Ranking de laboratórios (abaixo dos dados) e os 5 cartões de caso.
const labs = getLabs();
const credits = getLogoCredits();
---

<Layout title={title} description={description}>
  <CustomersIndex labs={labs} credits={credits} client:load />
</Layout>
