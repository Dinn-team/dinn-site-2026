---
import Layout from '@/layouts/Layout.astro';
import { CustomerDetail } from '@/components/site/CustomersPages';
import { customers } from '@/data/customers';

// Cada cliente de src/data/customers.ts ganha a sua página em /clientes/<slug>.
export function getStaticPaths() {
  return customers.map((c) => ({
    params: { slug: c.slug },
    props: { slug: c.slug, title: c.title, description: c.metaDescription },
  }));
}

const { slug, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://dinn.ai');
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'pt-BR',
  author: { '@type': 'Organization', name: 'Dinn' },
  publisher: { '@type': 'Organization', name: 'Dinn', url: site.href },
};
---

<Layout title={`${title} | Dinn`} description={description} type="article" jsonLd={article}>
  <CustomerDetail slug={slug} client:load />
</Layout>
