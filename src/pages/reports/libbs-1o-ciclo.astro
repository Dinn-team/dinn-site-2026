---
// Página restrita: não aparece no menu, no rodapé nem nos buscadores.
// O deck é uma apresentação em tela cheia com scroll controlado, por isso não
// usa o Layout padrão (o Header fixo e o Footer conflitam com o modo fullscreen).
// As fontes são declaradas abaixo em vez de importar @/styles/fonts.css: aquele
// arquivo carrega uma folha de estilo inteira junto (inclusive
// `section { margin-bottom: 80px }`, que desalinharia as telas do deck).
import LibbsCiclo1Deck from '@/components/reports/LibbsCiclo1Deck';

const title = 'Dinn Report Libbs — 1º Ciclo';
const description =
  'Análise dos feedbacks enviados pela equipe Libbs no 1º ciclo, com CSAT e ações realizadas.';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<LibbsCiclo1Deck client:load />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Britti Sans';
		font-weight: 300;
		font-style: normal;
		font-display: swap;
		src: url('/fonts/BrittiSans-Light.otf') format('opentype');
	}
	@font-face {
		font-family: 'Britti Sans';
		font-weight: 400;
		font-style: normal;
		font-display: swap;
		src: url('/fonts/BrittiSans-Regular.otf') format('opentype');
	}
	@font-face {
		font-family: 'Britti Sans';
		font-weight: 600;
		font-style: normal;
		font-display: swap;
		src: url('/fonts/BrittiSans-SemiBold.otf') format('opentype');
	}
	@font-face {
		font-family: 'Britti Sans';
		font-weight: 700;
		font-style: normal;
		font-display: swap;
		src: url('/fonts/BrittiSans-Bold.otf') format('opentype');
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #1f2328;
		overflow: hidden;
	}

	/* O deck controla o próprio espaçamento — nada de margens herdadas. */
	section {
		margin: 0;
	}

	::selection {
		background: #5625f2;
		color: #fff;
	}

	a {
		color: #b39cff;
	}

	a:hover {
		color: #fff;
	}

	.dr-scroll::-webkit-scrollbar {
		width: 6px;
	}

	.dr-scroll::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.18);
		border-radius: 99px;
	}
</style>
