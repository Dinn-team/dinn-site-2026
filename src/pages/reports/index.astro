---
import Layout from '@/layouts/Layout.astro';
import ReportsList from '@/components/reports/ReportsList';
import { reportsByDate } from '@/data/reports';
---

<Layout
    title="Reports | Dinn"
    description="Reports e apresentações sobre o Dinn e sobre resultados com clientes."
    noindex
>
    <ReportsList client:load reports={reportsByDate} />
</Layout>

<style is:global>
/* ── Página geral ── */
.reports-page {
  background-color: #ffffff;
  color: #1a1a1a;
  min-height: 100vh;
}

/* ── Hero mínimo ── */
.reports-hero {
  background-color: #0f172a; /* mantém identidade do DINN */
  padding: 64px 24px 56px;
  text-align: center;
}

.reports-hero-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #B39CFF;
  background: rgba(86, 37, 242, 0.16);
  border: 1px solid rgba(86, 37, 242, 0.38);
  border-radius: 999px;
  padding: 6px 16px;
  margin-bottom: 20px;
}

.reports-hero h1 {
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
  letter-spacing: -0.02em;
}

.reports-hero p {
  font-size: 16px;
  color: #94a3b8;
  margin-bottom: 32px;
  max-width: 46ch;
  margin-left: auto;
  margin-right: auto;
}

.reports-search {
  max-width: 480px;
  margin: 0 auto;
  position: relative;
}

.reports-search input {
  width: 100%;
  padding: 14px 48px 14px 24px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.08);
  color: #fff;
  font-size: 15px;
  outline: none;
  transition: border-color 0.2s;
}

.reports-search input::placeholder { color: #64748b; }
.reports-search input:focus { border-color: rgba(255,255,255,0.3); }

.reports-search-icon {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  color: #64748b;
}

/* ── Filtros por cliente ── */
.reports-filters {
  max-width: 1120px;
  margin: 0 auto;
  padding: 32px 24px 0;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.reports-filter-btn {
  padding: 8px 18px;
  border-radius: 999px;
  border: 1px solid #e2e8f0;
  background: transparent;
  font-size: 14px;
  color: #475569;
  cursor: pointer;
  transition: all 0.15s;
  font-weight: 500;
}

.reports-filter-btn:hover {
  border-color: #94a3b8;
  color: #1e293b;
}

.reports-filter-btn.active {
  background: #0f172a;
  border-color: #0f172a;
  color: #ffffff;
}

/* ── Container principal ── */
.reports-container {
  max-width: 1120px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ── Card em destaque (report mais recente) ── */
.reports-featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  margin-bottom: 64px;
  padding-bottom: 64px;
  border-bottom: 1px solid #e2e8f0;
}

/* Sem grid abaixo, a régua e o respiro do destaque ficariam soltos. */
.reports-featured--only {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.reports-featured-tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #5625F2; /* Dinn Accent */
  margin-bottom: 12px;
}

.reports-featured-title {
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
  margin-bottom: 16px;
  letter-spacing: -0.01em;
}

.reports-featured-excerpt {
  font-size: 16px;
  color: #475569;
  line-height: 1.7;
  margin-bottom: 24px;
}

.reports-featured-meta {
  font-size: 13px;
  color: #94a3b8;
  margin-bottom: 24px;
}

.reports-featured-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
  text-decoration: none;
  border-bottom: 2px solid #0f172a;
  padding-bottom: 2px;
  transition: opacity 0.15s;
}

.reports-featured-link:hover { opacity: 0.6; }

/* ── Números-chave do report em destaque ── */
.reports-highlights {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
  margin-bottom: 28px;
  padding: 20px 0;
  border-top: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
}

.reports-highlight-value {
  font-size: 24px;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.2;
}

.reports-highlight-label {
  font-size: 12px;
  color: #64748b;
  margin-top: 2px;
}

/* ── Grid de reports ── */
.reports-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

/* ── Card individual ── */
.reports-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  transition: transform 0.2s;
}

.reports-card:hover { transform: translateY(-4px); }
.reports-card:hover .reports-card-title { color: #5625F2; /* Dinn Accent */ }

.reports-card-meta {
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.reports-card-category {
  color: #5625F2; /* Dinn Accent */
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.reports-card-title {
  font-size: 17px;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  margin-bottom: 10px;
  transition: color 0.15s;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.reports-card-excerpt {
  font-size: 14px;
  color: #64748b;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Capa em CSS (mesma paleta do deck) ── */
.reports-cover {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 12px;
  overflow: hidden;
  background-color: #1F2328;
  background-image:
    radial-gradient(1.5px 1.5px at 12% 22%, rgba(255,255,255,0.85), transparent 60%),
    radial-gradient(1px 1px at 28% 48%, rgba(255,255,255,0.6), transparent 60%),
    radial-gradient(1.5px 1.5px at 44% 16%, rgba(255,255,255,0.75), transparent 60%),
    radial-gradient(1px 1px at 62% 36%, rgba(255,255,255,0.55), transparent 60%),
    radial-gradient(1.5px 1.5px at 74% 24%, rgba(255,255,255,0.85), transparent 60%),
    radial-gradient(1px 1px at 88% 12%, rgba(255,255,255,0.6), transparent 60%),
    linear-gradient(to bottom, #181b22 0%, #1c1f3a 38%, #241f42 62%, #1F2328 100%);
  display: flex;
  align-items: flex-end;
}

.reports-cover-glow {
  position: absolute;
  right: -10%;
  top: -40%;
  width: 70%;
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(86,37,242,0.35), transparent 62%);
  pointer-events: none;
}

.reports-cover-content {
  position: relative;
  z-index: 1;
  padding: clamp(16px, 4%, 32px);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.reports-cover-client {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #B39CFF;
}

.reports-cover-title {
  font-size: clamp(15px, 2.2vw, 22px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.25;
  letter-spacing: -0.01em;
}

/* ── Responsivo ── */
@media (max-width: 900px) {
  .reports-featured { grid-template-columns: 1fr; gap: 24px; }
  .reports-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
}

@media (max-width: 560px) {
  .reports-grid { grid-template-columns: 1fr; }
  .reports-hero { padding: 48px 20px 40px; }
  .reports-highlights { gap: 24px; }
}
</style>
