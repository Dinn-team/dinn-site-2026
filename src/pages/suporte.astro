---
import Layout from '@/layouts/Layout.astro';
import { SupportPage } from '@/components/support/SupportPage';
import { LANGS } from '@/i18n/routes';

// Suporte da Dinn (SAU): como a pessoa pede ajuda e como as dúvidas são resolvidas.
// Conteúdo em português. As versões em inglês e espanhol seguem na forma anterior.
const links = { pt: '/suporte', en: '/en/support', es: '/es/soporte' };
---

<Layout
  title="Suporte | Dinn"
  description="Peça ajuda dentro da plataforma. A Zoe, agente de IA da Dinn, atende no chat e a equipe Dinn assume quando precisa."
  alternates={LANGS.map((code) => ({ lang: code, href: links[code] }))}
>
  <SupportPage client:load />
</Layout>
