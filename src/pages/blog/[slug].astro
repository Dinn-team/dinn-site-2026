---
import Layout from '@/layouts/Layout.astro';
import { client, urlFor } from '@/sanity/lib/client';
import { postBySlugQuery } from '@/sanity/lib/queries';
import { PortableText } from '@portabletext/react';
import { Translate, TranslatedDate } from '@/components/ui/Translate';

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;
const post = await client.fetch(postBySlugQuery, { slug });

if (!post) {
  return Astro.redirect('/blog');
}

// Fetch recommended posts (excluding current)
const recommendedPosts = await client.fetch(
  `*[_type == "post" && slug.current != $slug] | order(publishedAt desc)[0...3]`,
  { slug }
);

// Calcular tempo de leitura (média 200 palavras/min)
function calcReadTime(body: any[]): number {
  if (!body) return 1;
  const totalChars = body.reduce((acc: number, block: any) => {
    if (block._type === 'block' && block.children) {
      return acc + block.children.reduce((a: number, child: any) => a + (child.text?.length || 0), 0);
    }
    return acc;
  }, 0);
  const words = totalChars / 5;
  return Math.max(1, Math.ceil(words / 200));
}

const readTime = calcReadTime(post.body);
const coverUrl = post.coverImage ? urlFor(post.coverImage).width(1400).height(700).fit('crop').url() : null;
---

<Layout
  title={`${post.title} | Blog Dinn`}
  description={post.excerpt || `Leia o artigo: ${post.title}`}
>
  <div class="bp-page pt-24">

    <!-- Hero Image -->
    {coverUrl && (
      <div class="bp-hero">
        <img src={coverUrl} alt={post.title} class="bp-hero-img" />
        <div class="bp-hero-overlay" />
      </div>
    )}

    <!-- Reading column -->
    <div class="bp-content">

      <!-- Meta: category + read time -->
      <div class="bp-meta">
        {post.categories && post.categories.length > 0 && (
          <span class="bp-category">{post.categories[0]}</span>
        )}
        <span class="bp-dot">·</span>
        <span class="bp-readtime">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {readTime} <Translate client:load i18nKey="blog.minRead" fallback="min de leitura" />
        </span>
      </div>

      <!-- Title -->
      <h1 class="bp-title">{post.title}</h1>

      <!-- Date + author -->
      <div class="bp-byline">
        {post.author && (
          <span class="bp-author">
            <Translate client:load i18nKey="blog.writtenBy" fallback="Por" /> {post.author}
          </span>
        )}
        {post.author && post.publishedAt && <span class="bp-dot">·</span>}
        {post.publishedAt && (
          <time class="bp-date">
            <TranslatedDate client:load dateString={post.publishedAt} />
          </time>
        )}
      </div>

      <!-- Excerpt / Lead -->
      {post.excerpt && (
        <p class="bp-excerpt">{post.excerpt}</p>
      )}

      <hr class="bp-divider" />

      <!-- Article body -->
      <div class="bp-body">
        {post.body && (
          <PortableText
            value={post.body}
            components={{
              types: {
                image: ({ value }: any) => {
                  const url = urlFor(value).width(900).url();
                  return `<figure class="bp-figure">
                    <img src="${url}" alt="${value.alt || ''}" class="bp-img" />
                    ${value.caption ? `<figcaption class="bp-caption">${value.caption}</figcaption>` : ''}
                  </figure>`;
                }
              }
            }}
          />
        )}
      </div>

      <!-- CTA Dinn -->
      <div class="bp-cta">
        <div class="bp-cta-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
        </div>
        <p class="bp-cta-title"><Translate client:load i18nKey="blog.ctaTitle" fallback="Transforme dados em decisões estratégicas" /></p>
        <p class="bp-cta-text"><Translate client:load i18nKey="blog.ctaText" fallback="A Dinn centraliza inteligência de mercado para indústrias farmacêuticas — monitoramento de PDV, ruptura de estoque e sell-out em tempo real." /></p>
        <a href="/#contato" class="bp-cta-btn">
          <Translate client:load i18nKey="blog.ctaBtn" fallback="Solicitar demonstração" />
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Recommended Articles -->
      {recommendedPosts && recommendedPosts.length > 0 && (
        <div class="bp-recommended">
          <h3 class="bp-recommended-title">
            <Translate client:load i18nKey="blog.recommended" fallback="Recomendados para você" />
          </h3>
          <div class="bp-recommended-grid">
            {recommendedPosts.map((rec: any) => (
              <a href={`/blog/${rec.slug.current}`} class="bp-rec-card">
                {rec.coverImage && (
                  <div class="bp-rec-img-wrap">
                    <img src={urlFor(rec.coverImage).width(400).height(250).url()} alt={rec.title} class="bp-rec-img" />
                  </div>
                )}
                <div class="bp-rec-content">
                  <h4 class="bp-rec-title">{rec.title}</h4>
                  <span class="bp-rec-link">
                    <Translate client:load i18nKey="blog.readArticle" fallback="Ler artigo" /> →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back link -->
      <a href="/blog" class="bp-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <Translate client:load i18nKey="blog.backToBlog" fallback="Voltar para o Blog" />
      </a>

    </div>
  </div>
</Layout>

<style is:global>
  /* ── Reset & Page ── */
  .bp-page {
    background-color: var(--bg-page);
    min-height: 100vh;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  /* ── Hero ── */
  .bp-hero {
    position: relative;
    width: 100%;
    height: 480px;
    overflow: hidden;
  }
  .bp-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .bp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--bg-page) 100%);
  }

  /* ── Reading column ── */
  .bp-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 52px 24px 96px;
  }

  /* ── Meta ── */
  .bp-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .bp-category {
    background-color: rgba(86, 37, 242, 0.08);
    color: var(--color-accent);
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .bp-dot {
    color: var(--color-border);
    font-size: 18px;
    line-height: 1;
  }
  .bp-readtime {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ── Title ── */
  .bp-title {
    font-family: var(--font-heading);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 18px;
    letter-spacing: -0.03em;
  }

  /* ── Byline ── */
  .bp-byline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 36px;
  }
  .bp-author {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .bp-date {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* ── Excerpt / Lead ── */
  .bp-excerpt {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-primary);
    border-left: 3px solid var(--color-accent);
    padding-left: 20px;
    margin-bottom: 36px;
    font-weight: 500;
  }

  /* ── Divider ── */
  .bp-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-bottom: 44px;
  }

  /* ── Article Body ── */
  .bp-body {
    font-size: 18px;
    line-height: 1.8;
    color: var(--text-body);
  }
  .bp-body p {
    margin-bottom: 26px;
  }
  .bp-body h2 {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 60px;
    margin-bottom: 18px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .bp-body h3 {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 44px;
    margin-bottom: 14px;
    line-height: 1.3;
  }
  .bp-body ul,
  .bp-body ol {
    padding-left: 26px;
    margin-bottom: 26px;
  }
  .bp-body li {
    margin-bottom: 10px;
    line-height: 1.7;
  }
  .bp-body ul li::marker {
    color: var(--color-accent);
  }
  .bp-body strong {
    font-weight: 700;
    color: var(--text-primary);
  }
  .bp-body a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(86, 37, 242, 0.35);
    transition: text-decoration-color 0.2s;
  }
  .bp-body a:hover {
    text-decoration-color: var(--color-accent);
  }
  .bp-body blockquote {
    border-left: 3px solid var(--color-accent);
    padding: 10px 0 10px 24px;
    margin: 40px 0;
    color: var(--text-primary);
    background: var(--bg-surface);
    border-radius: 0 8px 8px 0;
    font-size: 19px;
    line-height: 1.6;
    font-weight: 500;
  }

  /* ── Figure / Image ── */
  .bp-figure {
    margin: 40px 0;
  }
  .bp-img {
    width: 100%;
    border-radius: 12px;
    display: block;
    box-shadow: var(--shadow-sm);
  }
  .bp-caption {
    text-align: center;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 12px;
  }

  /* ── CTA Block ── */
  .bp-cta {
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 48px 36px;
    margin-top: 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .bp-cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: white;
    border-radius: 12px;
    margin: 0 auto 24px;
    color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }
  .bp-cta-title {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .bp-cta-text {
    font-size: 16px;
    color: var(--text-body);
    line-height: 1.65;
    margin-bottom: 32px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }
  .bp-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-accent);
    color: #fff;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    font-size: 15px;
    transition: all 0.2s;
  }
  .bp-cta-btn:hover {
    background-color: var(--color-accent-hov);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(86, 37, 242, 0.25);
  }

  /* ── Recommended Articles ── */
  .bp-recommended {
    margin-top: 80px;
    padding-top: 56px;
    border-top: 1px solid var(--color-border);
  }
  .bp-recommended-title {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  .bp-recommended-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 24px;
  }
  .bp-rec-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--bg-page);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s;
  }
  .bp-rec-card:hover {
    border-color: rgba(86, 37, 242, 0.5);
    box-shadow: 0 10px 25px -5px rgba(86, 37, 242, 0.08);
    transform: translateY(-4px);
  }
  .bp-rec-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-surface);
    overflow: hidden;
  }
  .bp-rec-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bp-rec-content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .bp-rec-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bp-rec-link {
    margin-top: auto;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ── Back link ── */
  .bp-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    margin-top: 64px;
    transition: color 0.2s;
  }
  .bp-back:hover {
    color: var(--color-accent);
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .bp-hero { height: 260px; }
    .bp-content { padding: 36px 20px 72px; }
    .bp-title { font-size: 32px; }
    .bp-excerpt { font-size: 18px; }
    .bp-body { font-size: 17px; }
    .bp-body h2 { font-size: 24px; margin-top: 48px; }
    .bp-body h3 { font-size: 20px; margin-top: 36px; }
    .bp-cta { padding: 32px 20px; }
    .bp-recommended-grid { grid-template-columns: 1fr; }
  }
</style>

