---
import Layout from '@/layouts/Layout.astro';
import { client, urlFor } from '@/sanity/lib/client';
import { postBySlugQuery, postsQuery } from '@/sanity/lib/queries';
import { PortableText } from '@portabletext/react';

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((post: any) => ({ 
    params: { slug: post.slug } 
  }));
}

const { slug } = Astro.params;
const post = await client.fetch(postBySlugQuery, { slug });

if (!post) {
  return Astro.redirect('/blog');
}

const coverUrl = post.coverImage ? urlFor(post.coverImage).width(1200).height(630).url() : null;
const publishedDate = post.publishedAt 
  ? new Date(post.publishedAt).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<Layout 
  title={`${post.title} | Blog Dinn`} 
  description={post.excerpt || `Leia o artigo: ${post.title}`}
>
  <article class="blog-article">
    {coverUrl && (
      <div class="blog-cover">
        <img src={coverUrl} alt={post.title} />
      </div>
    )}

    <div class="blog-container">
      <header class="blog-header">
        {post.categories && post.categories.length > 0 && (
          <div class="blog-categories">
            {post.categories.map((cat: string) => (
              <span class="blog-tag">{cat}</span>
            ))}
          </div>
        )}
        <h1>{post.title}</h1>
        {post.excerpt && <p class="blog-excerpt">{post.excerpt}</p>}
        <div class="blog-meta">
          {post.author && <span class="blog-author">Por {post.author}</span>}
          {publishedDate && <span class="blog-date">{publishedDate}</span>}
        </div>
      </header>

      <div class="blog-content">
        {post.body && (
          <PortableText 
            value={post.body}
            components={{
              types: {
                image: ({ value }: any) => {
                  const url = urlFor(value).width(800).url();
                  return `<img src="${url}" alt="${value.alt || ''}" class="blog-inline-img" />`;
                }
              }
            }}
          />
        )}
      </div>

      <footer class="blog-footer">
        <a href="/blog" class="blog-back">← Voltar para o Blog</a>
      </footer>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-article {
    min-height: 100vh;
    background: #1F2328;
    color: #e2e8f0;
  }

  .blog-cover {
    width: 100%;
    max-height: 500px;
    overflow: hidden;
  }
  .blog-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-container {
    max-width: 768px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .blog-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 2rem;
  }

  .blog-categories {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .blog-tag {
    background: rgba(2, 196, 175, 0.15);
    color: #02C4AF;
    border: 1px solid rgba(2, 196, 175, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin: 1rem 0;
  }

  .blog-excerpt {
    font-size: 1.2rem;
    color: #94a3b8;
    line-height: 1.6;
    font-style: italic;
    border-left: 3px solid #02C4AF;
    padding-left: 1rem;
    margin: 1.5rem 0;
  }

  .blog-meta {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-size: 0.9rem;
    color: #64748b;
    margin-top: 1rem;
  }
  .blog-author {
    font-weight: 600;
    color: #94a3b8;
  }

  .blog-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #cbd5e1;
  }
  .blog-content p {
    margin-bottom: 1.5rem;
  }
  .blog-content h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #fff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .blog-content h3 {
    font-size: 1.375rem;
    font-weight: 700;
    color: #e2e8f0;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .blog-content ul, .blog-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .blog-content li {
    margin-bottom: 0.5rem;
  }
  .blog-content strong {
    color: #fff;
    font-weight: 600;
  }
  .blog-content a {
    color: #02C4AF;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-content blockquote {
    border-left: 3px solid #02C4AF;
    padding-left: 1rem;
    margin: 2rem 0;
    color: #94a3b8;
    font-style: italic;
  }
  .blog-inline-img {
    width: 100%;
    border-radius: 0.75rem;
    margin: 2rem 0;
  }

  .blog-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .blog-back {
    color: #02C4AF;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s;
  }
  .blog-back:hover {
    opacity: 0.7;
  }
</style>
