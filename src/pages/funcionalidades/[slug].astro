---
import Layout from '@/layouts/Layout.astro';
import { FeatureDeepPage } from '@/components/features/FeatureDeepPage';
import { FEATURE_CONTENT } from '@/components/features/content';
import { JeanPage } from '@/components/site/JeanPage';
import { pagesPt } from '@/i18n/locales/pt.pages';
import { FEATURE_SLUGS } from '@/lib/site-map';

export function getStaticPaths() {
  return FEATURE_SLUGS.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const feature = pagesPt.features.items.find((f) => f.id === slug)!;
// A Jean tem página própria (JeanPage). As funcionalidades com conteúdo completo usam o molde do
// Suporte (FeatureDeepPage).
const deep = FEATURE_CONTENT[slug];
const meta = slug === 'jean' ? pagesPt.jean.meta : deep ? deep.meta : { title: `${feature.name} | Dinn`, description: feature.problem };
---

<Layout title={meta.title} description={meta.description}>
  {slug === 'jean' ? <JeanPage client:load /> : deep ? <FeatureDeepPage c={deep} client:load /> : null}
</Layout>
