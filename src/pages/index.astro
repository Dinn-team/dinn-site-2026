---
import Layout from '@/layouts/Layout.astro';
import { Hero2 } from '@/components/home2/Hero2';
import { Customers2 } from '@/components/home2/Customers2';
import { Features2 } from '@/components/home2/Features2';
import { Areas2 } from '@/components/home2/Areas2';
import { Showcase2 } from '@/components/home2/Showcase2';
import { Resources2 } from '@/components/home2/Resources2';
import { FaqBot2 } from '@/components/home2/FaqBot2';
import { getClientLogos } from '@/lib/clients';

// Faixa de clientes (âncora #clientes): só entram logos com arquivo em public/clientes.
const logos = getClientLogos();

// Home nova (29/10/2026), no modelo da Harvey e da ElevenLabs. Ver rules/REFERENCES_UI_UX.md.
// Hero com vídeo → clientes → como funciona → para a sua área → casos → recursos → dúvidas (bot).
---

<Layout>
  <div class="h2">
    <Hero2 client:load />
    <Customers2 logos={logos} client:idle />
    <Features2 client:idle />
    <Areas2 client:idle />
    <Showcase2 client:visible />
    <Resources2 client:visible />
    <FaqBot2 client:visible />
  </div>
</Layout>
