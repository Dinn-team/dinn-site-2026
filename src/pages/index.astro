---
import Layout from '@/layouts/Layout.astro';
import { AnimatedHero } from '@/components/ui/animated-hero';
import { ClientLogos } from '@/components/ui/ClientLogos';
import { AntesEDepoisSection } from '@/components/ui/AntesEDepoisSection';
import { ComoFuncionaSection } from '@/components/ui/ComoFuncionaSection';
import { NaPraticaSection } from '@/components/ui/NaPraticaSection';
import { NaSuaIaSection } from '@/components/ui/NaSuaIaSection';
import { ConectaSection } from '@/components/ui/ConectaSection';
import { SolucoesSection } from '@/components/ui/SolucoesSection';
import { TestimonialsSection } from '@/components/ui/TestimonialsSection';
import FAQ from '@/components/FAQ';
import CTASection from '@/components/CTASection';

// Narrativa da home (docs/positioning/2026-09-home-roteiro.md):
// dor → como funciona (sinal → ação) → exemplo → entrega (IA e Conecta)
// → soluções por resultado/time → prova social → dúvidas → chamada final.
---

<Layout>
  <AnimatedHero client:load />

  <div style="background: var(--color-black);">
    <ClientLogos client:visible />
    <AntesEDepoisSection client:visible />
  </div>

  <ComoFuncionaSection client:visible />
  <NaPraticaSection client:visible />
  <NaSuaIaSection client:visible />
  <ConectaSection client:visible />
  <SolucoesSection client:visible />
  <TestimonialsSection client:visible />
  <FAQ client:visible />
  <CTASection client:visible />
</Layout>
