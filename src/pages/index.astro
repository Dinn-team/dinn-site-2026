---
import Layout from '@/layouts/Layout.astro';
import { HeroSection } from '@/components/home/HeroSection';
import { StorySection } from '@/components/home/StorySection';
import { InsideSection } from '@/components/home/InsideSection';
import { AreasSection } from '@/components/home/AreasSection';
import { TeamsSection } from '@/components/home/TeamsSection';
import { InsightsSection } from '@/components/home/InsightsSection';
import { DeliverySection, FinalCta } from '@/components/home/DeliverySection';
import { ContentTeaser } from '@/components/home/ContentTeaser';
import { TestimonialsSection } from '@/components/ui/TestimonialsSection';
import FAQ from '@/components/FAQ';
import { getClientLogos } from '@/lib/clients';

// Faixa de clientes (âncora #clientes): só entram logos com arquivo em public/clientes.
const logos = getClientLogos();

// Narrativa da home (14/10/2026, síntese de decisão do conteúdo do site):
// promessa e prova social → o problema → como funciona, em um exemplo → caminhos
// por área → casos de uso → Dinn Insights → plataforma e capacidades → clientes
// → conteúdos → dúvidas → chamada final. As páginas de plataforma, soluções,
// confiança e recursos aprofundam cada ponto. Clientes vive só aqui (#clientes).
---

<Layout>
  <div class="v2">
    <HeroSection logos={logos} client:load />
    <StorySection client:idle />
    <InsideSection client:idle />
    <AreasSection client:idle />
    <TeamsSection client:idle />
    <InsightsSection client:idle />
    <DeliverySection client:idle />
    <TestimonialsSection client:visible />
    <ContentTeaser client:visible />
    <FAQ client:visible />
    <FinalCta client:idle />
  </div>
</Layout>
